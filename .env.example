# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# You only need a key for the backend you actually use. `--demo` needs none at all.

# Default backend. Get a key from https://serper.dev
# 2,500 free queries, no credit card, then about $1 per 1,000.
SERPER_API_KEY=

# Only needed for `--provider gemini`. Get a key from https://aistudio.google.com/apikey
# 5,000 free grounded prompts/month, then about $14 per 1,000.
# Note: this backend cannot paginate -- see docs/DECISIONS.md ADR-006.
GEMINI_API_KEY=

# --- Optional overrides; every one of these has a sensible default -----------
# GP_PROVIDER=serper
# GP_MAX_QUERIES=50          # hard budget stop; the run aborts rather than overspend
# GP_MAX_PAGES=3             # result pages per company
# GP_RESULTS_PER_PAGE=100    # Serper page size, max 100
# GP_CONCURRENCY=3           # simultaneous in-flight searches
# GP_RATE_LIMIT_PER_MINUTE=30
# GP_COUNTRY=ae              # Serper `gl` -- biases results by country
# GP_LANGUAGE=en             # Serper `hl`
# GP_CACHE_TTL_HOURS=168     # one week
# GP_CACHE_DIR=.cache
# GP_MODEL=gemini-3.6-flash
