# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# You only need a key for the backend you actually use. `--demo` needs none at all.

# Default backend. Get a key from https://serper.dev
# 2,500 free queries, no credit card, then about $1 per 1,000.
SERPER_API_KEY=

# Only needed for `--provider gemini`. Get a key from https://aistudio.google.com/apikey
# 5,000 free grounded prompts/month, then about $14 per 1,000.
# Note: this backend cannot paginate -- see docs/DECISIONS.md ADR-006.
GEMINI_API_KEY=

# --- Infrastructure only -----------------------------------------------------
# Everything describing WHAT you search for -- location, country, language,
# roles, keywords, depth, strictness -- lives in search.yaml, not here.
#
# GP_PROVIDER=serper
# GP_MAX_QUERIES=50          # hard budget stop for any single run; the run
#                            # aborts rather than overspend. An account-level
#                            # guard, not a property of a search.
# GP_RESULTS_PER_PAGE=100    # Serper page size. LEAVE UNSET on a free plan:
#                            # Serper rejects num > 10 for queries using search
#                            # operators unless you are on a paid plan. Use
#                            # max_pages in search.yaml to fetch more instead.
# GP_CONCURRENCY=3           # simultaneous in-flight searches
# GP_RATE_LIMIT_PER_MINUTE=30
# GP_CACHE_TTL_HOURS=168     # one week
# GP_CACHE_DIR=.cache
# GP_MODEL=gemini-3.6-flash
