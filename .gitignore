# --- Secrets -------------------------------------------------------------
# The API key lives here and must never be committed. .env.example is tracked.
.env

# --- Local config ----------------------------------------------------------
# Your own search brief. search.example.yaml is the tracked template.
search.yaml
search-*.yaml
agencies.yaml

# --- Output ---------------------------------------------------------------
# Generated prospect data contains real people's names and job titles.
out/
*.csv

# scripts/record_fixture.py writes a real API response here, containing real
# names and employers. The repository ships fabricated profiles only, so the
# recording stays local -- nothing in the test suite reads it.
tests/fixtures/

# --- Cache ----------------------------------------------------------------
.cache/
.grounded_prospector_cache/

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tooling --------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

